# Rihla Global - Environment Variables
# Copy this file to .env in the project root and fill in your values

# Server Configuration
NODE_ENV=production
PORT=5000

# Session Secret (generate a secure random string)
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-here

# Database (PostgreSQL) - Optional if using in-memory storage
# DATABASE_URL=postgresql://username:password@localhost:5432/rihla_global

# AI Integration (for chatbot)
# If using OpenAI directly:
# OPENAI_API_KEY=sk-your-openai-api-key

# If using Replit AI Integrations (only works on Replit):
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://...
# AI_INTEGRATIONS_OPENAI_API_KEY=...
